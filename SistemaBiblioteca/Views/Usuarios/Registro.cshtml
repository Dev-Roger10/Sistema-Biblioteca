@model SistemaBiblioteca.Models.ViewModels.RegistroViewModel

@{
    ViewData["Title"] = "Registro de Usuario";
    ViewData["OcultarFooter"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-wrap">
    <div class="auth-card lg">

        <aside class="auth-side">
            <div class="side-icon"><i class="fas fa-user-plus"></i></div>
            <h2>Crea tu cuenta</h2>
            <p>Regístrate para usar el catálogo, reservar libros y seguir tus préstamos.</p>
            <ul>
                <li><i class="fas fa-check-circle"></i> Solo toma un minuto</li>
                <li><i class="fas fa-check-circle"></i> Usa tu correo para ingresar</li>
            </ul>
        </aside>

        <div class="auth-main">
            <h1 class="auth-title">Crear nueva cuenta</h1>
            <p class="auth-sub">Completa el formulario para registrarte</p>

            <form id="formRegistro" asp-action="Registro" method="post" class="auth-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                <div class="row g-3">
                    <div class="col-md-6 col-lg-4">
                        <label asp-for="Nombres" class="form-label">Nombres *</label>
                        <input asp-for="Nombres" class="form-control" placeholder="Ej: Juan Carlos">
                        <span asp-validation-for="Nombres" class="text-danger field-error"></span>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <label asp-for="Apellidos" class="form-label">Apellidos *</label>
                        <input asp-for="Apellidos" class="form-control" placeholder="Ej: García López">
                        <span asp-validation-for="Apellidos" class="text-danger field-error"></span>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <label asp-for="DNI" class="form-label">DNI *</label>
                        <input asp-for="DNI" class="form-control" placeholder="12345678" maxlength="8">
                        <span asp-validation-for="DNI" class="text-danger field-error"></span>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <label asp-for="Telefono" class="form-label">Teléfono</label>
                        <input asp-for="Telefono" class="form-control" placeholder="987654321">
                        <span asp-validation-for="Telefono" class="text-danger field-error"></span>
                    </div>
                    <div class="col-lg-8">
                        <label asp-for="Direccion" class="form-label">Dirección</label>
                        <input asp-for="Direccion" class="form-control" placeholder="Av. Principal 123">
                        <span asp-validation-for="Direccion" class="text-danger field-error"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Correo" class="form-label">Correo electrónico * <span class="fw-normal text-muted">(para iniciar sesión)</span></label>
                        <input asp-for="Correo" class="form-control" type="email" placeholder="correo@ejemplo.com">
                        <span asp-validation-for="Correo" class="text-danger field-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="IdRol" class="form-label">Tipo de usuario *</label>
                        <select asp-for="IdRol" class="form-select" required>
                            <option value="">-- Seleccione --</option>
                            @foreach (var rol in ViewBag.Roles as List<SistemaBiblioteca.Models.Rol> ?? new List<SistemaBiblioteca.Models.Rol>())
                            {
                                <option value="@rol.IdRol">@rol.NombreRol</option>
                            }
                        </select>
                        <span asp-validation-for="IdRol" class="text-danger field-error"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Contrasena" class="form-label">Contraseña * <span class="fw-normal text-muted">(mín. 6)</span></label>
                        <div class="input-group">
                            <input asp-for="Contrasena" class="form-control" type="password" id="password" placeholder="••••••••">
                            <button class="btn" type="button" onclick="togglePasswordReg('password', 'icon1')" aria-label="Mostrar u ocultar contraseña">
                                <i class="fas fa-eye" id="icon1"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Contrasena" class="text-danger field-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmarContrasena" class="form-label">Confirmar contraseña *</label>
                        <div class="input-group">
                            <input asp-for="ConfirmarContrasena" class="form-control" type="password" id="confirmar" placeholder="••••••••">
                            <button class="btn" type="button" onclick="togglePasswordReg('confirmar', 'icon2')" aria-label="Mostrar u ocultar contraseña">
                                <i class="fas fa-eye" id="icon2"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmarContrasena" class="text-danger field-error"></span>
                    </div>

                    <div class="col-md-7 d-flex align-items-center">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="terminos" required>
                            <label class="form-check-label" for="terminos">
                                Acepto los <a href="#" class="auth-link">términos y condiciones</a>
                                y la <a href="#" class="auth-link">política de privacidad</a>
                            </label>
                        </div>
                    </div>
                    <div class="col-md-5 d-grid">
                        <button type="submit" class="btn btn-primary btn-submit">
                            <i class="fas fa-user-check"></i> Crear cuenta
                        </button>
                    </div>
                </div>
            </form>

            <p class="auth-alt mb-0">
                ¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function togglePasswordReg(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        // Aviso rápido si las contraseñas no coinciden (el servidor también lo valida).
        // Se engancha al formulario por id: querySelector('form') podía tomar otro
        // formulario de la página (p. ej. del layout).
        document.getElementById('formRegistro').addEventListener('submit', function (e) {
            const pass = document.getElementById('password').value;
            const confirm = document.getElementById('confirmar').value;

            if (pass !== confirm) {
                e.preventDefault();
                alert('Las contraseñas no coinciden');
                document.getElementById('confirmar').focus();
            }
        });
    </script>
}
