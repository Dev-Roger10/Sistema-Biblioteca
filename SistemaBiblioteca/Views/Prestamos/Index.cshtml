@model IEnumerable<SistemaBiblioteca.Models.Prestamo>

@{
    ViewData["Title"] = "Gestión de Préstamos";
    string filtroActual = ViewBag.Filtro as string ?? "";
    string buscarActual = ViewBag.Buscar as string ?? "";
    string desdeActual = ViewBag.FechaDesde as string ?? "";
    string hastaActual = ViewBag.FechaHasta as string ?? "";
    string Chip(string valor) => filtroActual == valor ? "active" : "";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h2 class="fw-bold color1">
            <i class="fas fa-exchange-alt color2"></i> Gestión de Préstamos
        </h2>
        <p class="color2">Administra los préstamos del sistema</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nuevo Préstamo
        </a>
    </div>
</div>

<!-- Resumen (totales de toda la biblioteca; no cambian con los filtros) -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-4">
        <div class="metric">
            <div class="m-icon c-teal"><i class="fas fa-book-open"></i></div>
            <div>
                <div class="m-val">@ViewBag.PrestamosActivos</div>
                <div class="m-lbl">Préstamos activos</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-4">
        <div class="metric">
            <div class="m-icon c-red"><i class="fas fa-exclamation-triangle"></i></div>
            <div>
                <div class="m-val">@ViewBag.PrestamosVencidos</div>
                <div class="m-lbl">Préstamos vencidos</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="metric">
            <div class="m-icon c-gray"><i class="fas fa-check-double"></i></div>
            <div>
                <div class="m-val">@ViewBag.PrestamosDevueltos</div>
                <div class="m-lbl">Devueltos</div>
            </div>
        </div>
    </div>
</div>

<!-- Filtros -->
<div class="toolbar mb-4">
    <div class="filter-chips mb-3">
        <a asp-action="Index" asp-route-buscar="@buscarActual" asp-route-fechaDesde="@desdeActual" asp-route-fechaHasta="@hastaActual" class="@Chip("")">Todos</a>
        <a asp-action="Index" asp-route-filtro="activos" asp-route-buscar="@buscarActual" asp-route-fechaDesde="@desdeActual" asp-route-fechaHasta="@hastaActual" class="@Chip("activos")">Activos</a>
        <a asp-action="Index" asp-route-filtro="vencidos" asp-route-buscar="@buscarActual" asp-route-fechaDesde="@desdeActual" asp-route-fechaHasta="@hastaActual" class="@Chip("vencidos")">Vencidos</a>
        <a asp-action="Index" asp-route-filtro="devueltos" asp-route-buscar="@buscarActual" asp-route-fechaDesde="@desdeActual" asp-route-fechaHasta="@hastaActual" class="@Chip("devueltos")">Devueltos</a>
    </div>

    <form method="get" class="row g-3 align-items-end">
        <input type="hidden" name="filtro" value="@filtroActual" />
        <div class="col-12 col-lg-5">
            <label class="form-label" for="buscar">Buscar</label>
            <input type="text" id="buscar" name="buscar" class="form-control" value="@buscarActual"
                   placeholder="Usuario, DNI, libro o código de ejemplar...">
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label" for="fechaDesde">Desde</label>
            <input type="date" id="fechaDesde" name="fechaDesde" class="form-control" value="@desdeActual">
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label" for="fechaHasta">Hasta</label>
            <input type="date" id="fechaHasta" name="fechaHasta" class="form-control" value="@hastaActual">
        </div>
        <div class="col-12 col-lg-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">
                <i class="fas fa-search"></i> Buscar
            </button>
            @if (!string.IsNullOrEmpty(buscarActual) || !string.IsNullOrEmpty(desdeActual) || !string.IsNullOrEmpty(hastaActual) || !string.IsNullOrEmpty(filtroActual))
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar filtros" aria-label="Limpiar filtros">
                    <i class="fas fa-times"></i>
                </a>
            }
        </div>
    </form>
</div>

<!-- Tabla de préstamos -->
<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-inbox d-block"></i>
                <h5>No hay préstamos para mostrar</h5>
                <p class="mb-0">Prueba con otros filtros o registra un nuevo préstamo.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Usuario</th>
                            <th>Libro</th>
                            <th>Ejemplar</th>
                            <th>Préstamo</th>
                            <th>Devolución</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prestamo in Model)
                        {
                            var devuelto = prestamo.FechaDevolucionReal != null || prestamo.EstadoPrestamo == "Devuelto";
                            var vencido = !devuelto && prestamo.EstaVencido;
                            var nombre = prestamo.Usuario.NombreCompleto ?? "";
                            var inicial = nombre.Length > 0 ? nombre.Substring(0, 1).ToUpper() : "?";
                            <tr class="@(vencido ? "table-danger" : "")">
                                <td class="text-muted">#@prestamo.IdPrestamo</td>
                                <td>
                                    <div class="person">
                                        <span class="avatar-sm">@inicial</span>
                                        <div>
                                            <div class="p-name">@nombre</div>
                                            <div class="p-sub">DNI @prestamo.Usuario.DNI</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="p-name">@prestamo.Ejemplar.Libro.Titulo</div>
                                    <div class="p-sub">@prestamo.Ejemplar.Libro.Autor</div>
                                </td>
                                <td><span class="code-pill">@prestamo.Ejemplar.CodigoEjemplar</span></td>
                                <td class="text-nowrap">@prestamo.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                                <td class="text-nowrap">
                                    @prestamo.FechaDevolucionEsperada.ToString("dd/MM/yyyy")
                                    @if (vencido)
                                    {
                                        <div class="small text-danger fw-semibold">
                                            <i class="fas fa-clock"></i> @((DateTime.Now - prestamo.FechaDevolucionEsperada).Days) día(s) de retraso
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (devuelto)
                                    {
                                        <span class="badge badge-soft s-muted">Devuelto</span>
                                    }
                                    else if (vencido)
                                    {
                                        <span class="badge badge-soft s-danger">Vencido</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft s-success">Activo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (!devuelto)
                                    {
                                        <a asp-action="Devolver" asp-route-id="@prestamo.IdPrestamo" class="btn btn-success btn-sm">
                                            <i class="fas fa-undo"></i> Devolver
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="px-3 py-2 small text-muted border-top">Mostrando @Model.Count() préstamo(s)</div>
        }
    </div>
</div>
