@model SistemaBiblioteca.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Inicio";
    var userId = Context.Session.GetInt32("UsuarioId");
    var userRole = Context.Session.GetString("UsuarioRol");
    var userName = Context.Session.GetString("UsuarioNombre");
    var esStaff = userRole == "Administrador" || userRole == "Bibliotecario";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="home-page">
@if (userId != null)
{
    <!-- ========== DASHBOARD ========== -->
    <section class="welcome-banner mb-4">
        <span class="role-pill"><i class="fas fa-user-shield me-1"></i> @userRole</span>
        <h1>Hola, @userName</h1>
        <p>Este es el resumen de tu biblioteca el día de hoy.</p>
    </section>

    <!-- Estadísticas (datos reales; para lectores son solo las propias) -->
    <section class="row g-3 g-md-4 mb-5">
        <div class="col-6 col-lg-3">
            <div class="metric">
                <div class="m-icon c-blue"><i class="fas @(Model.EsPersonal ? "fa-book" : "fa-hand-holding")"></i></div>
                <div>
                    <div class="m-val">@(Model.EsPersonal ? Model.LibrosActivos : Model.PrestamosActivos)</div>
                    <div class="m-lbl">@(Model.EsPersonal ? "Libros en catálogo" : "Mis préstamos activos")</div>
                    @if (Model.EsPersonal)
                    {
                        <div class="m-note text-success"><i class="fas fa-arrow-up"></i> @Model.LibrosNuevosMes este mes</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="metric">
                <div class="m-icon c-teal"><i class="fas fa-exchange-alt"></i></div>
                <div>
                    <div class="m-val">@(Model.EsPersonal ? Model.PrestamosActivos : Model.EjemplaresDisponibles)</div>
                    <div class="m-lbl">@(Model.EsPersonal ? "Préstamos activos" : "Ejemplares disponibles")</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="metric">
                <div class="m-icon c-amber"><i class="fas fa-bookmark"></i></div>
                <div>
                    <div class="m-val">@Model.ReservasPendientes</div>
                    <div class="m-lbl">@(Model.EsPersonal ? "Reservas pendientes" : "Mis reservas pendientes")</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="metric">
                <div class="m-icon c-red"><i class="fas @(Model.EsPersonal ? "fa-exclamation-triangle" : "fa-gavel")"></i></div>
                <div>
                    <div class="m-val">@(Model.EsPersonal ? Model.PrestamosVencidos : Model.SancionesPendientes)</div>
                    <div class="m-lbl">@(Model.EsPersonal ? "Préstamos vencidos" : "Sanciones pendientes")</div>
                    @if (Model.EsPersonal && Model.PrestamosVencidos > 0)
                    {
                        <div class="m-note text-danger">Acción requerida</div>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- Acciones rápidas -->
    <section class="mb-5">
        <div class="dash-title"><i class="fas fa-bolt"></i> Acciones rápidas</div>
        <div class="row g-4">
            @if (esStaff)
            {
                <div class="col-sm-6 col-lg-3">
                    <a asp-controller="Prestamos" asp-action="Create" class="action-tile">
                        <i class="fas fa-arrow-right a-arrow"></i>
                        <div class="a-icon"><i class="fas fa-plus"></i></div>
                        <h5>Registrar préstamo</h5>
                        <p>Nuevo préstamo de libro</p>
                    </a>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <a asp-controller="Prestamos" asp-action="Index" class="action-tile">
                        <i class="fas fa-arrow-right a-arrow"></i>
                        <div class="a-icon alt"><i class="fas fa-undo"></i></div>
                        <h5>Devoluciones</h5>
                        <p>Procesar devoluciones</p>
                    </a>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <a asp-controller="Libros" asp-action="Create" class="action-tile">
                        <i class="fas fa-arrow-right a-arrow"></i>
                        <div class="a-icon"><i class="fas fa-book-medical"></i></div>
                        <h5>Agregar libro</h5>
                        <p>Nuevo libro al catálogo</p>
                    </a>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <a asp-controller="Sanciones" asp-action="Index" class="action-tile">
                        <i class="fas fa-arrow-right a-arrow"></i>
                        <div class="a-icon warm"><i class="fas fa-gavel"></i></div>
                        <h5>Gestionar sanciones</h5>
                        <p>Pagos y multas</p>
                    </a>
                </div>
            }
            else
            {
                <div class="col-md-4">
                    <a asp-controller="Libros" asp-action="Catalogo" class="action-tile">
                        <i class="fas fa-arrow-right a-arrow"></i>
                        <div class="a-icon"><i class="fas fa-search"></i></div>
                        <h5>Buscar libros</h5>
                        <p>Explora nuestro catálogo</p>
                    </a>
                </div>
                <div class="col-md-4">
                    <a asp-controller="Reservas" asp-action="MisReservas" class="action-tile">
                        <i class="fas fa-arrow-right a-arrow"></i>
                        <div class="a-icon alt"><i class="fas fa-bookmark"></i></div>
                        <h5>Mis reservas</h5>
                        <p>Ver mis reservas activas</p>
                    </a>
                </div>
                <div class="col-md-4">
                    <a asp-controller="Prestamos" asp-action="MisPrestamos" class="action-tile">
                        <i class="fas fa-arrow-right a-arrow"></i>
                        <div class="a-icon"><i class="fas fa-hand-holding"></i></div>
                        <h5>Mis préstamos</h5>
                        <p>Estado de mis libros</p>
                    </a>
                </div>
            }
        </div>
    </section>
}
else
{
    <!-- ========== LANDING (sin sesión) ========== -->
    <section class="hero full-bleed">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <span class="hero-eyebrow"><span class="dot"></span> Biblioteca Universitaria</span>
                    <h1>Tu biblioteca,<br /><span class="accent">siempre a un clic</span></h1>
                    <p class="lead-text mb-0">
                        Explora el catálogo, reserva libros y controla tus préstamos de forma rápida,
                        desde tu computadora o tu móvil.
                    </p>
                </div>

                <div class="col-lg-6 d-none d-lg-block">
                    <div class="hero-visual">
                        <div class="glass-card gc-1">
                            <div class="gc-icon"><i class="fas fa-book-open"></i></div>
                            <strong>Catálogo completo</strong>
                            <span>Busca por título, autor o categoría</span>
                        </div>
                        <div class="glass-card gc-2">
                            <div class="gc-icon"><i class="fas fa-bookmark"></i></div>
                            <strong>Reserva en línea</strong>
                            <span>Aparta tu libro sin hacer fila</span>
                        </div>
                        <div class="glass-card gc-3">
                            <div class="gc-icon"><i class="fas fa-bell"></i></div>
                            <strong>Avisos de devolución</strong>
                            <span>Nunca olvides una fecha límite</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Franja de datos reales -->
    <section class="stat-strip mb-5">
        <div class="strip">
            <div class="row g-0">
                <div class="col-6 col-md-3 strip-item">
                    <div class="num">@Model.LibrosActivos</div>
                    <div class="lbl"><i class="fas fa-book"></i> Libros en catálogo</div>
                </div>
                <div class="col-6 col-md-3 strip-item">
                    <div class="num">@Model.EjemplaresDisponibles</div>
                    <div class="lbl"><i class="fas fa-check-circle"></i> Ejemplares disponibles</div>
                </div>
                <div class="col-6 col-md-3 strip-item">
                    <div class="num">@Model.Categorias</div>
                    <div class="lbl"><i class="fas fa-tags"></i> Categorías</div>
                </div>
                <div class="col-6 col-md-3 strip-item">
                    <div class="num">@Model.Sedes</div>
                    <div class="lbl"><i class="fas fa-building"></i> Sedes</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Características -->
    <section class="mb-5 pt-3">
        <div class="section-head">
            <span class="kicker">Qué ofrecemos</span>
            <h2>Todo lo que necesitas en un solo lugar</h2>
            <p>Una plataforma pensada para estudiantes, docentes y personal de la biblioteca.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-book"></i></div>
                    <h4>Catálogo en línea</h4>
                    <p>Busca libros por título, autor o categoría y revisa su disponibilidad.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-clock"></i></div>
                    <h4>Reservas y préstamos</h4>
                    <p>Reserva tu libro y sigue el estado de tus préstamos desde tu cuenta.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-mobile-alt"></i></div>
                    <h4>Avisos y sanciones</h4>
                    <p>Recibe notificaciones y consulta tus sanciones en un solo lugar.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Cómo funciona -->
    <section class="steps-wrap mb-5">
        <div class="section-head">
            <span class="kicker">Cómo funciona</span>
            <h2>Empieza en tres pasos</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4 step">
                <div class="badge-num">1</div>
                <h5>Crea tu cuenta</h5>
                <p>Regístrate con tus datos de la universidad.</p>
            </div>
            <div class="col-md-4 step">
                <div class="badge-num">2</div>
                <h5>Busca y reserva</h5>
                <p>Encuentra tu libro y resérvalo en segundos.</p>
            </div>
            <div class="col-md-4 step">
                <div class="badge-num">3</div>
                <h5>Recógelo y disfruta</h5>
                <p>Retíralo en la sede y sigue tu préstamo en línea.</p>
            </div>
        </div>
    </section>

    <!-- Llamado final -->
    <section class="cta-band mb-4">
        <h3>¿Listo para empezar?</h3>
        <p class="mb-4">Inicia sesión o crea tu cuenta y accede al catálogo completo.</p>
        <a asp-controller="Usuarios" asp-action="Registro" class="btn-hero solid">
            <i class="fas fa-user-plus"></i> Registrarme ahora
        </a>
    </section>
}
</div>

@section Scripts {
    <script>
        // Auto-hide alerts after 5 seconds
        setTimeout(function() {
            $('.alert').fadeOut('slow');
        }, 5000);
    </script>
}
