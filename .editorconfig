# Configuración común del editor para todo el repositorio.
# Visual Studio y VS Code la respetan automáticamente al guardar.
root = true

[*]
# UTF-8 evita que tildes y eñes se corrompan al abrir/guardar en distintos editores.
# Los saltos de línea los normaliza Git (.gitattributes: text=auto), por eso no se fijan aquí.
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,yml,yaml,csproj}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
